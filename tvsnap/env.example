# Copy to .env (gitignored by the repo's **/.env rule) and fill in.

# Cloudflare account + a token with R2 Storage:Edit, Workers Scripts:Edit,
# Account Settings:Read. Only deploy.sh reads these.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# The shared key, used for both read and write. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into the watch app's snapshot config.
API_KEY=

# Optional. A second key that can GET /snapshot but not PUT it — for other
# projects that only consume the JSON. Generate it the same way as API_KEY.
# Leave empty to keep the worker single-key.
READ_KEY=

# Written by deploy.sh; publish_snapshot.py reads it.
WORKER_URL=

# The metrics-server worker (~/cf_metrics), read-only use: fetch_marmot.py pulls
# the Tempest outside temperature back out of it. Same values as
# ~/cf_metrics/tempest/.env — WORKER_URL and API_KEY there.
METRICS_URL=https://metrics-server.<subdomain>.workers.dev
METRICS_KEY=<the metrics-server API key>
