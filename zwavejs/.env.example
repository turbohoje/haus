# Copy to .env (gitignored via **/.env) and fill in.

# Session secret for the zwave-js-ui web UI. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Z-Wave security keys (NOT read from env by zwave-js-ui — paste these into the
# UI at Settings -> Z-Wave -> Security Keys on first run). Kept here only so you
# don't lose them if the store volume is wiped. Generate each with:
#   openssl rand -hex 16
# ---------------------------------------------------------------------------
KEY_S0_LEGACY=
KEY_S2_UNAUTHENTICATED=
KEY_S2_AUTHENTICATED=
KEY_S2_ACCESS_CONTROL=
